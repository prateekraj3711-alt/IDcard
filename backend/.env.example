APP_ENV=dev
APP_NAME=idcard-api
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://idcard:idcard@localhost:5432/idcard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-prod-with-a-64-char-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

BCRYPT_ROUNDS=12

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PHOTOS=idcard-photos
S3_BUCKET_IDCARDS=idcard-cards
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MAX_PHOTO_BYTES=5242880
