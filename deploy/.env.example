# Copy to .env and fill in.
#
# Nothing here should ever be committed. .env is in .gitignore.

# --------- Public entrypoint ---------
# Domain that Caddy will fetch a Let's Encrypt cert for. Point an A/AAAA
# record at your VPS's IP before booting.
DOMAIN=idcard.example.com
ACME_EMAIL=you@example.com

# --------- App secrets ---------
# `openssl rand -hex 32`
JWT_SECRET=

# --------- Postgres ---------
POSTGRES_USER=idcard
POSTGRES_PASSWORD=
POSTGRES_DB=idcard

# --------- MinIO (S3-compatible) ---------
MINIO_ROOT_USER=idcard
MINIO_ROOT_PASSWORD=
S3_BUCKET_PHOTOS=idcard-photos
S3_BUCKET_IDCARDS=idcard-cards
# The URL the browser uses to reach MinIO's S3 endpoint via Caddy. Leave
# blank if MinIO stays fully internal (recommended — the backend fetches
# via the compose network). If you enable the /storage/* proxy in the
# Caddyfile, set this to https://$DOMAIN/storage
S3_PUBLIC_URL=

# --------- Initial super admin (created once on first boot) ---------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Site Admin
